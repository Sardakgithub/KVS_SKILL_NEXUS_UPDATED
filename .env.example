# ==============================================================================
# KVS Skill Nexus - Environment Configuration Template
# Copy this file to .env and fill in real values. NEVER commit the real .env
# ==============================================================================

# --- Core ---
DJANGO_ENV=development                 # development | production | testing
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL) ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=kvs_skill_nexus
DB_USER=kvs_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- JWT ---
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Email (used from Module 2 onwards for verification / reset) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=KVS Skill Nexus <no-reply@kvsskillnexus.com>

# --- Frontend ---
FRONTEND_URL=http://localhost:3000

# --- Sentry (production only) ---
SENTRY_DSN=

# --- Superuser bootstrap (optional, used by management command) ---
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
